#!/bin/bash
set -euo pipefail

# Konteyner veya servis adı
C="wireguard"
PEERS_FILE="/etc/wireguard/peers.map"

case "${1:-}" in
  start)
    docker start "$C"
    echo "state=running started=$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    ;;
  stop)
    docker stop "$C"
    echo "state=exited"
    ;;
  restart)
    docker restart "$C"
    echo "state=running started=$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    ;;
  status)
    docker inspect -f 'state={{.State.Status}} started={{.State.StartedAt}}' "$C" 2>/dev/null || echo "state=unknown"
    echo -n "peers="
    docker exec "$C" wg show all peers 2>/dev/null | wc -l || echo 0
    ;;
  list-peers)
    # peer=name|pubkey|ip|handshake_epoch|rx_bytes|tx_bytes
    if [ -f "$PEERS_FILE" ]; then
      while IFS='|' read -r name pub ip; do
        [ -z "$name" ] && continue
        DUMP=$(docker exec "$C" wg show wg0 dump 2>/dev/null | grep "$pub" || true)
        if [ -n "$DUMP" ]; then
          HS=$(echo "$DUMP" | awk '{print $5}')
          RX=$(echo "$DUMP" | awk '{print $6}')
          TX=$(echo "$DUMP" | awk '{print $7}')
        else
          HS=0; RX=0; TX=0
        fi
        echo "peer=$name|$pub|$ip|$HS|$RX|$TX"
      done < "$PEERS_FILE"
    else
      echo "peers=0"
    fi
    ;;
  add-peer)
    NAME="${2:-}"
    PUBKEY="${3:-}"
    if [ -z "$NAME" ] || [ -z "$PUBKEY" ]; then
      echo "error=missing name or pubkey" >&2
      exit 2
    fi
    mkdir -p "$(dirname "$PEERS_FILE")"
    touch "$PEERS_FILE"
    
    # Mevcut IP'leri kontrol edip yeni IP ata (10.66.66.X)
    COUNT=$(wc -l < "$PEERS_FILE" 2>/dev/null || echo 0)
    OCTET=$((COUNT + 2))
    NEW_IP="10.66.66.${OCTET}"
    
    # WireGuard içine ekle
    docker exec "$C" wg set wg0 peer "$PUBKEY" allowed-ips "${NEW_IP}/32"
    echo "$NAME|$PUBKEY|$NEW_IP" >> "$PEERS_FILE"
    
    # Sunucu genel bilgileri
    SERVER_PUB=$(docker exec "$C" wg show wg0 public-key 2>/dev/null || echo "SERVER_PUB_KEY")
    ENDPOINT="$(curl -s -4 ifconfig.me || echo "vpn.server.ip"):51820"
    echo "added=$NAME|$NEW_IP|$SERVER_PUB|$ENDPOINT|1.1.1.1"
    ;;
  remove-peer)
    NAME="${2:-}"
    if [ -z "$NAME" ]; then
      echo "error=missing peer name" >&2
      exit 2
    fi
    if [ -f "$PEERS_FILE" ]; then
      PUBKEY=$(grep "^$NAME|" "$PEERS_FILE" | cut -d'|' -f2 || true)
      if [ -n "$PUBKEY" ]; then
        docker exec "$C" wg set wg0 peer "$PUBKEY" remove 2>/dev/null || true
        sed -i "/^$NAME|/d" "$PEERS_FILE"
      fi
    fi
    echo "removed=$NAME"
    ;;
  *)
    echo "invalid action" >&2
    exit 2
    ;;
esac
