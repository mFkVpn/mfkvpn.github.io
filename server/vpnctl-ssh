#!/bin/bash
set -euo pipefail

# Sadece güvenli ve doğrulanmış komut formatlarına izin ver
# Örnekler:
#   start
#   stop
#   restart
#   status
#   list-peers
#   remove-peer <name>
#   add-peer <name> <base64_pubkey>

CMD="${SSH_ORIGINAL_COMMAND:-}"

# Girdi temizleme ve güvenli doğrulama
if [[ "$CMD" =~ ^(start|stop|restart|status|list-peers)$ ]]; then
  exec sudo /usr/local/bin/vpnctl "$CMD"
elif [[ "$CMD" =~ ^remove-peer[[:space:]]+([A-Za-z0-9_-]{1,24})$ ]]; then
  PEER_NAME="${BASH_REMATCH[1]}"
  exec sudo /usr/local/bin/vpnctl remove-peer "$PEER_NAME"
elif [[ "$CMD" =~ ^add-peer[[:space:]]+([A-Za-z0-9_-]{1,24})[[:space:]]+([A-Za-z0-9+/=]{40,50})$ ]]; then
  PEER_NAME="${BASH_REMATCH[1]}"
  PUB_KEY="${BASH_REMATCH[2]}"
  exec sudo /usr/local/bin/vpnctl add-peer "$PEER_NAME" "$PUB_KEY"
else
  echo "denied" >&2
  exit 1
fi
